# Generate a strong secret before production:
POWERX_API_KEY=

POWERX_RATE_LIMIT=60
POWERX_AUDIT_LOG=logs/powerx-audit.jsonl

# Runtime endpoints are OpenAI-compatible /v1 endpoints.
# Example only; replace with the runtimes actually running on your machines/device.
POWERX_RUNTIME_ENDPOINTS_JSON=[{"id":"gpu-main","model_id":"gpt-oss-20b","runtime_class":"gpu16","base_url":"http://127.0.0.1:8100/v1","priority":10},{"id":"cpu-fallback","model_id":"qwen-4b-local","runtime_class":"cpu","base_url":"http://127.0.0.1:8200/v1","priority":20},{"id":"mobile-fallback","model_id":"phi-mini-local","runtime_class":"mobile","base_url":"http://127.0.0.1:8300/v1","priority":30}]
