# Add these to the main .env after extracting Phase 3.

# llama.cpp binary path; if omitted, `llama-server` must be on PATH.
LLAMA_SERVER_BIN=

# CPU/local GGUF paths.
POWERX_QWEN4B_GGUF=
POWERX_PHI_MINI_GGUF=
POWERX_GEMMA1B_GGUF=

# Mobile GGUF slots.
POWERX_MOBILE_PRIMARY_GGUF=
POWERX_MOBILE_SMALL_GGUF=
POWERX_MOBILE_GUARD_GGUF=

# Optional specialized CPU services.
POWERX_FORECAST_PRIMARY_URL=
POWERX_FORECAST_SECONDARY_URL=
POWERX_EMBEDDING_URL=
POWERX_RERANKER_URL=
POWERX_GUARD_URL=
